<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ExpiryGuard" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.ExpiryGuard.Splash">
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Buttons: pill shaped, 48dp tall (Fitts's law) -->
    <style name="Widget.EG.Button.Filled" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">24dp</item>
        <item name="iconTint">@color/white</item>
    </style>

    <style name="Widget.EG.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="strokeColor">@color/outline_green</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="iconTint">@color/primary_dark</item>
        <item name="backgroundTint">@color/white</item>
    </style>

    <style name="Widget.EG.Button.Danger" parent="Widget.EG.Button.Outlined">
        <item name="android:textColor">@color/expired_text</item>
        <item name="strokeColor">@color/expired_text</item>
        <item name="iconTint">@color/expired_text</item>
    </style>

    <style name="Widget.EG.Button.Option" parent="Widget.EG.Button.Outlined">
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="iconPadding">4dp</item>
    </style>

    <style name="Widget.EG.Button.Option.Danger">
        <item name="android:textColor">@color/expired_text</item>
        <item name="strokeColor">@color/expired_text</item>
        <item name="iconTint">@color/expired_text</item>
    </style>

    <style name="Widget.EG.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary_dark</item>
    </style>

    <style name="Widget.EG.Button.Text.Danger">
        <item name="android:textColor">@color/expired_text</item>
    </style>

    <style name="Widget.EG.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:minHeight">48dp</item>
        <item name="chipMinHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="checkedIconTint">@color/primary_dark</item>
        <item name="chipIconVisible">false</item>
        <item name="checkedIconVisible">true</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <!-- Base EG style for dot-notation inheritance -->
    <style name="EG" />

    <!-- Text helpers -->
    <style name="EG.Label">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="EG.Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="EG.Error">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/error</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="EG.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_main</item>
    </style>
</resources>
